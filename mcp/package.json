{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server exposing DevDigest reviews, findings and conventions to MCP clients. Thin HTTP adapter over the DevDigest API — no database, no server internals.",
  "bin": {
    "devdigest": "bin/devdigest.mjs"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "review": "tsx src/cli/main.ts review",
    "inspect": "npx --yes @modelcontextprotocol/inspector npx tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
